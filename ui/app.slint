// =====================================================================
// Мелкие компоненты
// =====================================================================

/// Всплывающая подсказка: одна на всё окно, рисуется поверх (см. конец AppWindow).
global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
}

component Icon inherits Path {
    in property <color> tint: Theme.muted;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: tint;
    stroke-width: 2px;
    fill: transparent;
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> accent: false;
    in property <color> tint: Theme.muted;
    in property <color> hover-tint: Theme.text;
    in property <length> size: 32px;
    callback clicked();
    width: size;
    height: size;
    border-radius: 9px;
    background: accent ? (ta.has-hover ? #ff8c4a : Theme.accent) : (ta.has-hover ? Theme.card2 : Theme.card);
    animate background { duration: 120ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Icon {
        width: 16px;
        height: 16px;
        commands: root.icon;
        tint: root.accent ? white : (ta.has-hover ? root.hover-tint : root.tint);
    }
}

// Иконка без фона (в строках)
component GhostIcon inherits Rectangle {
    in property <string> icon;
    in property <color> tint: Theme.dim;
    in property <color> hover-tint: Theme.text;
    callback clicked();
    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: ta.has-hover ? #ffffff10 : transparent;
    animate background { duration: 120ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Icon {
        width: 15px;
        height: 15px;
        commands: root.icon;
        tint: ta.has-hover ? root.hover-tint : root.tint;
    }
}

component Switch inherits Rectangle {
    in property <bool> on;
    in property <color> on-color: Theme.accent;
    in property <length> h: 20px;
    callback toggled(bool);
    width: h * 1.75;
    height: h;
    border-radius: h / 2;
    background: on ? on-color : #3a414d;
    animate background { duration: 150ms; }
    Rectangle {
        width: root.h - 4px;
        height: root.h - 4px;
        y: 2px;
        x: root.on ? root.width - self.width - 2px : 2px;
        border-radius: self.height / 2;
        background: white;
        animate x { duration: 150ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
}

component Segmented inherits Rectangle {
    in property <[string]> items;
    in property <int> current;
    callback changed(int);
    height: 34px;
    border-radius: 10px;
    background: Theme.card;
    HorizontalLayout {
        padding: 3px;
        for it[i] in root.items: Rectangle {
            border-radius: 8px;
            background: i == root.current ? Theme.card2 : (sta.has-hover ? #ffffff08 : transparent);
            animate background { duration: 120ms; }
            Text {
                text: it;
                color: i == root.current ? Theme.text : Theme.muted;
                font-size: 12.5px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            sta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.changed(i); }
            }
        }
    }
}

component Section inherits Text {
    color: Theme.dim;
    font-size: 11px;
    letter-spacing: 0.6px;
}

/// Кружок «i»: наведение (или нажатие) показывает подсказку.
component InfoDot inherits Rectangle {
    in property <string> tip;
    width: 18px;
    height: 18px;
    Icon {
        width: 14px;
        height: 14px;
        stroke-width: 1.8px;
        commands: Icons.info;
        tint: ita.has-hover || Tip.text == root.tip ? Theme.text : Theme.dim;
    }
    ita := TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            if self.has-hover {
                Tip.text = root.tip;
                Tip.x = root.absolute-position.x + root.width / 2;
                Tip.y = root.absolute-position.y + root.height;
            } else if Tip.text == root.tip {
                Tip.text = "";
            }
        }
        clicked => {
            if Tip.text == root.tip {
                Tip.text = "";
            } else {
                Tip.text = root.tip;
                Tip.x = root.absolute-position.x + root.width / 2;
                Tip.y = root.absolute-position.y + root.height;
            }
        }
    }
}

/// Заголовок раздела с необязательной подсказкой «i».
component SectionHead inherits HorizontalLayout {
    in property <string> text;
    in property <string> tip;
    spacing: 4px;
    alignment: start;
    VerticalLayout {
        alignment: center;
        Section { text: root.text; }
    }
    if root.tip != "": InfoDot { tip: root.tip; }
}

/// Маленькая плашка с текстом (итоги сессии и т. п.).
component Chip inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 10.5px;
    /// Цвет метки («» по умолчанию — серая).
    in property <color> tint: transparent;
    height: self.font-size + 8px;
    width: ct.preferred-width + 14px;
    border-radius: 6px;
    background: root.tint == transparent ? #ffffff14 : root.tint.with-alpha(0.14);
    ct := Text { text: root.text; font-size: root.font-size; font-weight: 600; color: root.tint == transparent ? Theme.text : root.tint; }
}

/// Плашка-метка со стрелкой (сервер, стратегия): нажатие открывает выбор.
/// Подсветка при наведении — только вокруг самой плашки.
component TagButton inherits Rectangle {
    in property <string> text;
    /// Без плашки — просто текст (например, «Выбрать сервер»).
    in property <bool> plain: false;
    callback clicked();
    height: 28px;
    width: hl.preferred-width;
    border-radius: 8px;
    background: tba.has-hover ? #ffffff10 : transparent;
    animate background { duration: 120ms; }
    tba := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    hl := HorizontalLayout {
        padding-left: 4px;
        padding-right: 2px;
        spacing: 2px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 20px;
                width: min(tt.preferred-width + (root.plain ? 0px : 14px), 120px);
                border-radius: 6px;
                background: root.plain ? transparent : #ffffff14;
                tt := Text {
                    width: min(self.preferred-width, parent.width - (root.plain ? 0px : 14px));
                    text: root.text;
                    font-size: root.plain ? 12.5px : 11.5px;
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide;
                }
            }
        }
        VerticalLayout { alignment: center; Icon { width: 13px; height: 13px; commands: Icons.right; tint: tba.has-hover ? Theme.text : Theme.muted; } }
    }
}


/// Круглый переключатель выбора (как radio).
component Radio inherits Rectangle {
    in property <bool> on;
    in property <color> tint: Theme.accent;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border-width: 2px;
    border-color: on ? root.tint : #4a515e;
    background: transparent;
    animate border-color { duration: 120ms; }
    Rectangle {
        width: root.on ? 8px : 0px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.tint;
        animate width { duration: 120ms; easing: ease-out; }
    }
}

/// Строка настроек в новом стиле: цветной значок, название, подпись, справа — @children.
/// first/last — для скруглений подсветки и разделителя в карточке.
component IRow inherits Rectangle {
    in property <string> icon;
    in property <color> tint: Theme.muted;
    in property <string> title;
    in property <color> title-color: Theme.text;
    in property <string> subtitle;
    in property <color> subtitle-color: Theme.dim;
    in property <bool> clickable: false;
    /// Подсказка «i» рядом с названием.
    in property <string> tip;
    in property <bool> first: false;
    in property <bool> last: false;
    callback clicked();
    min-height: 52px;
    background: root.clickable && ita.has-hover ? #20252e : transparent;
    animate background { duration: 120ms; }
    border-top-left-radius: root.first ? 12px : 0px;
    border-top-right-radius: root.first ? 12px : 0px;
    border-bottom-left-radius: root.last ? 12px : 0px;
    border-bottom-right-radius: root.last ? 12px : 0px;
    if !root.first: Rectangle { y: 0; x: 50px; width: parent.width - 50px; height: 1px; background: #222731; }
    ita := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 8px;
                background: root.tint.with-alpha(0.14);
                Icon { width: 14px; height: 14px; commands: root.icon; tint: root.tint; }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            min-width: 0px;
            if root.tip == "": Text { text: root.title; color: root.title-color; font-size: 13px; overflow: elide; }
            if root.tip != "": HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Text { text: root.title; color: root.title-color; font-size: 13px; overflow: elide; vertical-alignment: center; }
                InfoDot { tip: root.tip; }
            }
            if root.subtitle != "": Text { text: root.subtitle; color: root.subtitle-color; font-size: 10.5px; overflow: elide; }
        }
        @children
    }
}

/// «›» справа в строке.
component Chevron inherits VerticalLayout {
    alignment: center;
    Icon { width: 15px; height: 15px; commands: Icons.right; tint: Theme.dim; }
}

/// Ctrl+C/V/X/A в русской раскладке: Slint узнаёт сочетания по букве ("c"),
/// а в ЙЦУКЕН та же клавиша даёт "с" — без этого копирование не работает.
global RuKeys {
    /// 0 — не наше, 1 копировать, 2 выделить всё, 3 вставить, 4 вырезать.
    public pure function action(e: KeyEvent) -> int {
        if (!e.modifiers.control || e.modifiers.alt) { return 0; }
        if (e.text == "с" || e.text == "С") { return 1; }
        if (e.text == "ф" || e.text == "Ф") { return 2; }
        if (e.text == "м" || e.text == "М") { return 3; }
        if (e.text == "ч" || e.text == "Ч") { return 4; }
        return 0;
    }
}

/// Однострочное поле ввода в стиле приложения (вместо системного поля из std-widgets).
/// inset — поле внутри карточки: фон темнее карточки.
component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <bool> inset: false;
    callback edited(string);
    callback accepted(string);
    forward-focus: ti;
    public function select-all() { ti.select-all(); }
    height: 36px;
    min-width: 60px;
    horizontal-stretch: 1;
    border-radius: 10px;
    background: root.inset ? Theme.bg : Theme.card;
    border-width: 1px;
    border-color: ti.has-focus ? #ff7a2f99 : fta.has-hover ? #ffffff14 : transparent;
    animate border-color { duration: 120ms; }
    fta := TouchArea { mouse-cursor: MouseCursor.text; clicked => { ti.focus(); } }
    ContextMenuArea {
        Menu {
            MenuItem { title: "Вырезать"; activated => { ti.cut(); } }
            MenuItem { title: "Копировать"; activated => { ti.copy(); } }
            MenuItem { title: "Вставить"; activated => { ti.paste(); } }
            MenuItem { title: "Выделить всё"; activated => { ti.select-all(); } }
        }
        Rectangle {
            x: 12px;
            width: parent.width - 24px;
            clip: true;
            if root.text == "" && root.placeholder-text != "": Text {
                width: 100%;
                text: root.placeholder-text;
                color: Theme.dim;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }
            FocusScope {
            capture-key-pressed(e) => {
                    let a = RuKeys.action(e);
                    if (a == 1) { ti.copy(); return accept; }
                    if (a == 2) { ti.select-all(); return accept; }
                    if (a == 3 && !false) { ti.paste(); return accept; }
                    if (a == 4 && !false) { ti.cut(); return accept; }
                    return reject;
                }
            ti := TextInput {
                text <=> root.text;
                single-line: true;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
                selection-background-color: #ff7a2f66;
                selection-foreground-color: Theme.text;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
            }
        }
    }
}

/// Многострочное поле (вставка ссылок, журнал) в том же стиле.
component Area inherits Rectangle {
    in-out property <string> text;
    in property <bool> read-only: false;
    in property <length> font-size: 12px;
    forward-focus: ti;
    border-radius: 12px;
    background: Theme.card;
    border-width: 1px;
    border-color: ti.has-focus && !root.read-only ? #ff7a2f99 : transparent;
    animate border-color { duration: 120ms; }
    TouchArea { mouse-cursor: MouseCursor.text; clicked => { ti.focus(); } }
    ContextMenuArea {
        Menu {
            if !root.read-only: MenuItem { title: "Вырезать"; activated => { ti.cut(); } }
            MenuItem { title: "Копировать"; activated => { ti.copy(); } }
            if !root.read-only: MenuItem { title: "Вставить"; activated => { ti.paste(); } }
            MenuItem { title: "Выделить всё"; activated => { ti.select-all(); } }
        }
        fl := Flickable {
            x: 12px;
            y: 10px;
            width: parent.width - 24px;
            height: parent.height - 20px;
            content-height: max(ti.preferred-height, self.height);
            // мышью — выделять текст, а не тащить страницу; прокрутка — колесом
            mouse-drag-pan-enabled: false;
            FocusScope {
            height: max(ti.preferred-height, fl.height);
            capture-key-pressed(e) => {
                    let a = RuKeys.action(e);
                    if (a == 1) { ti.copy(); return accept; }
                    if (a == 2) { ti.select-all(); return accept; }
                    if (a == 3 && !root.read-only) { ti.paste(); return accept; }
                    if (a == 4 && !root.read-only) { ti.cut(); return accept; }
                    return reject;
                }
            ti := TextInput {
                width: fl.width;
                text <=> root.text;
                read-only: root.read-only;
                single-line: false;
                wrap: word-wrap;
                color: Theme.text;
                font-size: root.font-size;
                selection-background-color: #ff7a2f66;
                selection-foreground-color: Theme.text;
            }
            }
        }
    }
}

/// Раздел настроек: заголовок, карточка и подсказка стоят плотно друг к другу.
component Group inherits VerticalLayout {
    spacing: 6px;
}

/// Подсказка под карточкой — везде одинаковая, выровнена по заголовку раздела.
component Hint inherits HorizontalLayout {
    in property <string> text;
    in property <bool> bad: false;
    Text {
        text: root.text;
        color: root.bad ? Theme.bad : Theme.dim;
        font-size: 11px;
        wrap: word-wrap;
    }
}

/// Карточка скорости: подпись слева вверху, скорость со стрелкой справа, график,
/// внизу «скачано» (по нижней границе плашки) и плашка с объёмом за сессию.
component SpeedCard inherits Rectangle {
    in property <string> label;
    in property <string> arrow;
    in property <color> tint;
    in property <string> num;
    in property <string> unit;
    in property <string> path;
    in property <string> word;
    in property <string> total;
    border-radius: 12px;
    background: Theme.card;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    VerticalLayout {
        padding: 10px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        HorizontalLayout {
            height: 24px;
            spacing: 4px;
            Text { text: root.label; color: Theme.muted; font-size: 11px; vertical-alignment: top; horizontal-stretch: 1; }
            Text { text: root.arrow; color: root.tint; font-size: 14px; font-weight: 700; vertical-alignment: bottom; }
            Text { text: root.num; color: Theme.text; font-size: 19px; font-weight: 700; vertical-alignment: bottom; }
            Text { text: root.unit; color: Theme.muted; font-size: 11px; vertical-alignment: bottom; }
        }
        Path {
            height: 28px;
            viewbox-width: 100;
            viewbox-height: 28;
            fit: fill;
            commands: root.path;
            stroke: root.tint;
            stroke-width: 1.6px;
            fill: transparent;
        }
        // Разделитель между графиком и итогом — как между строками «Трафика».
        Rectangle { height: 1px; background: #222731; }
        HorizontalLayout {
            height: 20px;
            Text { text: root.word; color: Theme.muted; font-size: 11px; vertical-alignment: bottom; horizontal-stretch: 1; }
            if root.total != "": Rectangle {
                height: 20px;
                width: tt.preferred-width + 14px;
                border-radius: 6px;
                background: #ffffff14;
                tt := Text { text: root.total; font-size: 11px; font-weight: 600; color: Theme.text; }
            }
        }
    }
}

/// Скруглённые углы для градиентного фона. Программная отрисовка не скругляет
/// Rectangle с градиентом (и не заливает градиентом Path), поэтому градиент рисуем
/// прямоугольником, а углы «срезаем» масками цвета фона страницы.
component CornerMasks inherits Rectangle {
    in property <float> r: 14;
    in property <color> bg: Theme.bg;
    // ↖
    Path { x: 0; y: 0; width: root.r * 1px; height: root.r * 1px; viewbox-width: root.r; viewbox-height: root.r; fill: root.bg; stroke-width: 0px;
        commands: "M 0 0 L " + root.r + " 0 A " + root.r + " " + root.r + " 0 0 0 0 " + root.r + " Z"; }
    // ↗
    Path { x: root.width - root.r * 1px; y: 0; width: root.r * 1px; height: root.r * 1px; viewbox-width: root.r; viewbox-height: root.r; fill: root.bg; stroke-width: 0px;
        commands: "M 0 0 L " + root.r + " 0 L " + root.r + " " + root.r + " A " + root.r + " " + root.r + " 0 0 0 0 0 Z"; }
    // ↙
    Path { x: 0; y: root.height - root.r * 1px; width: root.r * 1px; height: root.r * 1px; viewbox-width: root.r; viewbox-height: root.r; fill: root.bg; stroke-width: 0px;
        commands: "M 0 0 A " + root.r + " " + root.r + " 0 0 0 " + root.r + " " + root.r + " L 0 " + root.r + " Z"; }
    // ↘
    Path { x: root.width - root.r * 1px; y: root.height - root.r * 1px; width: root.r * 1px; height: root.r * 1px; viewbox-width: root.r; viewbox-height: root.r; fill: root.bg; stroke-width: 0px;
        commands: "M " + root.r + " 0 L " + root.r + " " + root.r + " L 0 " + root.r + " A " + root.r + " " + root.r + " 0 0 0 " + root.r + " 0 Z"; }
}

component Card inherits Rectangle {
    border-radius: 12px;
    background: Theme.card;
}

component Button2 inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary: false;
    /// Кнопка лежит на карточке — фон светлее, иначе сливается.
    in property <bool> raised: false;
    callback clicked();
    height: raised ? 30px : 36px;
    border-radius: raised ? 8px : 10px;
    background: primary ? (bta.has-hover ? #ff8c4a : Theme.accent)
        : raised ? (bta.has-hover ? #323946 : Theme.card2)
        : (bta.has-hover ? Theme.card2 : Theme.card);
    animate background { duration: 120ms; }
    min-width: hl.min-width;
    hl := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                width: 14px;
                height: 14px;
                commands: root.icon;
                tint: root.primary ? white : Theme.text;
            }
        }
        Text {
            text: root.text;
            color: root.primary ? white : Theme.text;
            font-size: 13px;
            font-weight: root.primary ? 600 : 400;
            vertical-alignment: center;
        }
    }
    bta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}


component Back inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 24px;
    HorizontalLayout {
        spacing: 4px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Icon { width: 16px; height: 16px; commands: Icons.left; tint: bta.has-hover ? Theme.text : Theme.muted; }
        }
        Text { text: root.text; color: bta.has-hover ? Theme.text : Theme.muted; font-size: 12.5px; vertical-alignment: center; }
    }
    bta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component MenuRow inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> danger: false;
    callback clicked();
    height: 34px;
    border-radius: 7px;
    background: mta.has-hover ? #ffffff10 : transparent;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon { width: 15px; height: 15px; commands: root.icon; tint: root.danger ? Theme.bad : Theme.muted; }
        }
        Text { text: root.text; color: root.danger ? Theme.bad : Theme.text; font-size: 13px; vertical-alignment: center; }
    }
    mta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Кнопка окна — цветной кружок. При наведении темнеет и показывает значок.
/// Ширина 22px (кружок 14 + по 4 с боков); область двух кнопок с отступом (48px)
/// передаётся в рамку окна Windows (main.rs → win_frame).
/// Кружок стоит в 8px от верхнего края — столько же, сколько от правого: ровно по углу окна.
component CaptionButton inherits Rectangle {
    in property <string> icon;
    in property <color> dot: Theme.accent;
    callback clicked();
    width: 22px;
    cta := TouchArea { clicked => { root.clicked(); } }
    Rectangle {
        y: 8px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: cta.pressed ? root.dot.darker(35%) : cta.has-hover ? root.dot.darker(15%) : root.dot;
        animate background { duration: 100ms; }
        Icon {
            width: 14px;
            height: 14px;
            stroke-width: 1.5px;
            commands: root.icon;
            tint: #000000a0;
            opacity: cta.has-hover ? 1 : 0;
            animate opacity { duration: 100ms; }
        }
    }
}

component TabButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active;
    callback clicked();
    VerticalLayout {
        alignment: center;
        spacing: 3px;
        HorizontalLayout {
            alignment: center;
            Icon {
                width: 20px;
                height: 20px;
                commands: root.icon;
                tint: root.active ? Theme.accent : (tta.has-hover ? Theme.muted : Theme.dim);
            }
        }
        Text {
            text: root.label;
            font-size: 10.5px;
            color: root.active ? Theme.accent : (tta.has-hover ? Theme.muted : Theme.dim);
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: root.active ? 18px : 0px;
                height: 3px;
                border-radius: 2px;
                background: Theme.accent;
                animate width { duration: 180ms; easing: ease-out; }
            }
        }
    }
    tta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Экран, который плавно появляется (прозрачность + небольшой сдвиг)
component Page inherits Rectangle {
    property <float> t: 0;
    init => { self.t = 1; }
    animate t { duration: 200ms; easing: ease-out; }
    opacity: t;
    Rectangle {
        y: (1 - root.t) * 12px;
        width: parent.width;
        height: parent.height;
        @children
    }
}

// =====================================================================
// Строки серверов
// =====================================================================

// Шапка группы — верхняя строка карточки: значок, «Название · N», подпись, «⋮», свернуть.
component GroupHeader inherits Rectangle {
    in property <Row> info;
    in property <bool> editing;
    callback toggle();
    callback refresh();
    callback start-rename();
    callback rename(string);
    callback copy-link();
    callback remove();
    height: 46px;
    background: hta.has-hover ? #252a33 : #20242d;
    animate background { duration: 120ms; }
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: root.info.last ? 12px : 0px;
    border-bottom-right-radius: root.info.last ? 12px : 0px;
    // Нажатие на шапку (кроме кнопок справа) — свернуть/развернуть.
    hta := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (!root.editing && self.mouse-x < self.width - 64px) { root.toggle(); } }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                width: 15px;
                height: 15px;
                commands: root.info.fav ? Icons.star : !root.info.refreshable ? Icons.servers : root.info.busy ? Icons.refresh : root.info.bad ? Icons.alert : Icons.cloud;
                tint: root.info.fav ? Theme.warn : !root.info.refreshable ? Theme.accent : root.info.busy ? Theme.accent : root.info.bad ? Theme.bad : Theme.vpn;
                // Пока обновляется — значок «дышит».
                opacity: root.info.busy ? 0.55 + 0.45 * sin(animation-tick() / 1ms * 0.006 * 1rad) : 1;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            min-width: 0px;
            if !root.editing: Text { text: root.info.title; color: Theme.text; font-size: 12.5px; font-weight: 600; overflow: elide; }
            if root.editing: Field {
                height: 30px;
                inset: true;
                text: root.info.title;
                accepted(t) => { root.rename(t); }
                init => {
                    self.focus();
                    self.select-all();
                }
            }
            if root.info.sub != "" && !root.editing: Text {
                text: root.info.sub;
                color: root.info.bad ? #ff9a90 : Theme.dim;
                font-size: 10.5px;
                overflow: elide;
            }
        }
        if root.info.refreshable: VerticalLayout {
            alignment: center;
            GhostIcon {
                icon: Icons.more;
                tint: Theme.muted;
                clicked => { menu.show(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                Icon { width: 14px; height: 14px; commands: root.info.collapsed ? Icons.right : Icons.down; tint: Theme.muted; }
                TouchArea { mouse-cursor: pointer; clicked => { root.toggle(); } }
            }
        }
    }

    menu := PopupWindow {
        x: root.width - 196px;
        y: 40px;
        width: 190px;
        Rectangle {
            background: Theme.card2;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 18px;
            drop-shadow-color: #000a;
            VerticalLayout {
                padding: 4px;
                MenuRow { text: "Обновить"; icon: Icons.refresh; clicked => { root.refresh(); } }
                MenuRow { text: "Переименовать"; icon: Icons.edit; clicked => { root.start-rename(); } }
                MenuRow { text: "Копировать ссылку"; icon: Icons.copy; clicked => { root.copy-link(); } }
                MenuRow { text: "Удалить подписку"; icon: Icons.trash; danger: true; clicked => { root.remove(); } }
            }
        }
    }
}

// Сервер — строка карточки группы (как в «Соединениях»): «⋮» выезжает при наведении.
component ServerRow inherits Rectangle {
    in property <Row> info;
    in property <bool> editing;
    callback clicked();
    callback start-edit();
    callback rename(string);
    callback copy-link();
    callback open-editor();
    callback remove();
    callback toggle-fav();
    property <length> menu-x;
    property <length> menu-y;
    property <bool> on-more: ta.has-hover && ta.mouse-x > self.width - 36px;

    height: 48px;
    background: root.info.selected ? #2a1d15 : (ta.has-hover ? #20252e : Theme.card);
    animate background { duration: 120ms; }
    border-bottom-left-radius: root.info.last ? 12px : 0px;
    border-bottom-right-radius: root.info.last ? 12px : 0px;

    // Разделитель сверху (под шапкой и между строками).
    Rectangle { y: 0; x: 12px; width: parent.width - 12px; height: 1px; background: #222731; }
    if root.info.selected: Rectangle {
        x: 0px;
        y: 10px;
        width: 3px;
        height: parent.height - 20px;
        border-radius: 2px;
        background: Theme.accent;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (self.mouse-x > self.width - 36px) {
                root.menu-x = root.width - 196px;
                root.menu-y = root.height - 6px;
                menu.show();
            } else {
                root.clicked();
            }
        }
        double-clicked => { root.start-edit(); }
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                root.menu-x = min(self.mouse-x, root.width - 196px);
                root.menu-y = self.mouse-y;
                menu.show();
            }
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;
        if root.info.code != "": Text {
            width: 20px;
            text: root.info.code;
            color: Theme.muted;
            font-size: 10px;
            font-weight: 700;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            min-width: 0px;
            if !root.editing: Text { text: root.info.title; color: Theme.text; font-size: 13px; overflow: elide; }
            if root.editing: Field {
                height: 28px;
                text: root.info.title;
                accepted(t) => { root.rename(t); }
                init => {
                    self.focus();
                    self.select-all();
                }
            }
            Text { text: root.info.sub; color: Theme.dim; font-size: 10.5px; overflow: elide; }
        }
        if root.info.ping != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 18px;
                width: pt.preferred-width + 14px;
                border-radius: 9px;
                background: root.info.ping-state == 1 ? #2fbf7122 : root.info.ping-state == 2 ? #e7b43c22 : root.info.ping-state == 3 ? #ec6a5e22 : Theme.card2;
                pt := Text {
                    text: root.info.ping;
                    font-size: 10.5px;
                    color: root.info.ping-state == 1 ? Theme.ok : root.info.ping-state == 2 ? Theme.warn : root.info.ping-state == 3 ? Theme.bad : Theme.muted;
                }
            }
        }
        // «⋮» выезжает при наведении и отодвигает пинг влево.
        Rectangle {
            width: ta.has-hover ? 26px : 0px;
            animate width { duration: 120ms; easing: ease-out; }
            clip: true;
            Rectangle {
                x: 0px;
                width: 26px;
                height: 26px;
                border-radius: 6px;
                background: root.on-more ? #ffffff14 : transparent;
                Icon { width: 15px; height: 15px; commands: Icons.more; tint: root.on-more ? Theme.text : Theme.muted; }
            }
        }
    }

    menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 190px;
        Rectangle {
            background: Theme.card2;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 18px;
            drop-shadow-color: #000a;
            VerticalLayout {
                padding: 4px;
                MenuRow { text: root.info.fav ? "Убрать из избранного" : "В избранное"; icon: Icons.star; clicked => { root.toggle-fav(); } }
                MenuRow { text: "Изменить…"; icon: Icons.edit; clicked => { root.open-editor(); } }
                MenuRow { text: "Копировать ссылку"; icon: Icons.copy; clicked => { root.copy-link(); } }
                MenuRow { text: "Удалить"; icon: Icons.trash; danger: true; clicked => { root.remove(); } }
            }
        }
    }
}

// Список правил — строка карточки: значок типа, название, что внутри, переключатель, «›».
component RuleListRow inherits Rectangle {
    in property <RuleCard> card;
    // Первая строка карточки (у базовых — первая в модели).
    in property <bool> first: root.card.index == 0;
    callback open();
    callback toggled(bool);
    property <color> tint: root.card.action == 0 ? Theme.vpn : root.card.action == 1 ? Theme.ok : root.card.action == 3 ? Theme.zap : Theme.bad;
    // «Через zapret» при выключенном zapret: его адреса сейчас идут как всё остальное.
    property <bool> idle: root.card.action == 3 && root.card.summary == "zapret выключен";
    height: 56px;
    background: lta.has-hover ? #20252e : Theme.card;
    animate background { duration: 120ms; }
    border-top-left-radius: root.first ? 12px : 0px;
    border-top-right-radius: root.first ? 12px : 0px;
    border-bottom-left-radius: root.card.last ? 12px : 0px;
    border-bottom-right-radius: root.card.last ? 12px : 0px;
    if !root.first: Rectangle { y: 0; x: 50px; width: parent.width - 50px; height: 1px; background: #222731; }
    lta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 8px;
                background: root.tint.with-alpha(0.14);
                opacity: root.idle ? 0.6 : 1;
                Icon {
                    width: 14px;
                    height: 14px;
                    commands: root.card.action == 0 ? Icons.shield : root.card.action == 1 ? Icons.arrow : root.card.action == 3 ? Icons.bolt : Icons.block;
                    tint: root.tint;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            min-width: 0px;
            Text { text: root.card.name; color: root.card.enabled ? Theme.text : Theme.muted; font-size: 13px; font-weight: 600; overflow: elide; }
            Text { text: root.card.summary; color: Theme.dim; font-size: 10.5px; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            Switch { on: root.card.enabled; on-color: root.card.action == 3 ? Theme.zap : Theme.accent; toggled(v) => { root.toggled(v); } }
        }
        VerticalLayout {
            alignment: center;
            Icon { width: 15px; height: 15px; commands: Icons.right; tint: Theme.dim; }
        }
    }
}

// Запись списка правил — строка карточки (как в «Серверах»): значок типа, текст, крестик при наведении.
// icon 5 — шапка карточки «Из сборки zapret» (нажатие — свернуть/развернуть), 6 — домен сборки (только чтение).
component EntryRow inherits Rectangle {
    in property <EntryItem> item;
    callback remove();
    callback toggle();
    property <bool> on-x: rta.has-hover && rta.mouse-x > self.width - 36px;
    // Над шапкой «Из сборки zapret» — отступ от карточки своих записей.
    height: root.item.icon == 5 ? 56px : root.item.icon == 6 ? 36px : 46px;

    // Фон карточки
    Rectangle {
        y: root.item.icon == 5 ? 10px : 0px;
        height: parent.height - self.y;
        background: root.item.icon == 5 ? (rta.has-hover ? #252a33 : #20242d) : (root.item.icon < 5 && rta.has-hover ? #20252e : Theme.card);
        animate background { duration: 120ms; }
        border-top-left-radius: root.item.first || root.item.icon == 5 ? 12px : 0px;
        border-top-right-radius: root.item.first || root.item.icon == 5 ? 12px : 0px;
        border-bottom-left-radius: root.item.last ? 12px : 0px;
        border-bottom-right-radius: root.item.last ? 12px : 0px;
        if !root.item.first && root.item.icon != 5: Rectangle { y: 0; x: 12px; width: parent.width - 12px; height: 1px; background: #222731; }

        // Шапка «Из сборки zapret · 81»
        if root.item.icon == 5: HorizontalLayout {
            padding-left: 12px;
            padding-right: 6px;
            spacing: 10px;
            VerticalLayout { alignment: center; Icon { width: 15px; height: 15px; commands: Icons.layers; tint: Theme.dim; } }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: root.item.text; color: Theme.muted; font-size: 12.5px; font-weight: 600; }
                Text { text: "только для чтения — файлы сборки zapret"; color: Theme.dim; font-size: 10.5px; }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 26px;
                    height: 26px;
                    Icon { width: 14px; height: 14px; commands: root.item.kind == "свернуть" ? Icons.down : Icons.right; tint: Theme.muted; }
                }
            }
        }
        // Домен из сборки: только для чтения.
        if root.item.icon == 6: HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 10px;
            VerticalLayout { alignment: center; Rectangle { width: 28px; height: 20px; Icon { width: 13px; height: 13px; commands: Icons.globe; tint: Theme.dim; } } }
            Text { text: root.item.text; color: Theme.muted; font-size: 12.5px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
            Text { text: root.item.kind == "только домен" ? "только домен" : ""; color: Theme.dim; font-size: 10.5px; vertical-alignment: center; }
        }
        // Своя запись
        if root.item.icon < 5: HorizontalLayout {
            padding-left: 10px;
            padding-right: 8px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 8px;
                    background: root.item.icon == 3 ? #ec6a5e1a : root.item.icon == 4 ? #ff7a2f1a : Theme.card2;
                    Icon {
                        width: 14px;
                        height: 14px;
                        commands: root.item.icon == 0 ? Icons.app : root.item.icon == 1 ? Icons.globe : root.item.icon == 2 ? Icons.net : root.item.icon == 4 ? Icons.layers : Icons.alert;
                        tint: root.item.icon == 3 ? Theme.bad : root.item.icon == 4 ? Theme.accent : Theme.muted;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                min-width: 0px;
                Text { text: root.item.text; color: root.item.icon == 3 ? Theme.bad : Theme.text; font-size: 13px; overflow: elide; }
                Text { text: root.item.kind; color: root.item.icon == 3 ? #ff9a90 : Theme.dim; font-size: 10.5px; overflow: elide; }
            }
            // Крестик выезжает при наведении.
            Rectangle {
                width: rta.has-hover ? 26px : 0px;
                animate width { duration: 120ms; easing: ease-out; }
                clip: true;
                Rectangle {
                    x: 0px;
                    width: 26px;
                    height: 26px;
                    border-radius: 6px;
                    background: root.on-x ? #ec6a5e22 : transparent;
                    Icon { width: 14px; height: 14px; commands: Icons.close; tint: root.on-x ? Theme.bad : Theme.dim; }
                }
            }
        }
    }
    rta := TouchArea {
        mouse-cursor: root.item.icon == 5 || root.on-x ? pointer : default;
        clicked => {
            if (root.item.icon == 5) { root.toggle(); }
            else if (root.item.icon < 5 && self.mouse-x > self.width - 36px) { root.remove(); }
        }
    }
}

// =====================================================================
// Окно
// =====================================================================

export component AppWindow inherits Window {
    title: "Foxray";
    icon: @image-url("icon.png");
    no-frame: root.frameless;
    // Linux: по краям — прозрачные поля под тень (окно чуть больше самого Foxray).
    width: 380px + 2 * root.pad;
    height: 720px + 2 * root.pad;
    // Linux: окно без рамки — углы скругляем сами (как у Windows 11), за углами окно прозрачное.
    background: root.frameless ? transparent : Theme.bg;
    default-font-size: 13px;

    in-out property <int> tab: 0;

    // ---- Главная ----
    in property <int> state: 0;            // 0 выкл, 1 подключение, 2 подключено, 3 ошибка
    in property <string> status-title: "Отключено";
    in property <string> status-sub: "";
    in property <string> uptime: "";
    in property <bool> has-server: false;
    in property <string> cur-name;
    in property <string> cur-desc;
    in property <string> cur-tag;
    in property <string> cur-ping;
    in property <[RouteRow]> routes;
    callback route-clicked(int);
    in property <string> zapret-home-title;
    in property <string> zapret-home-sub;
    in property <string> zapret-home-strategy;
    in property <bool> zapret-home-bad: false;
    in property <string> down-num: "0";
    in property <string> down-unit: "Б/с";
    in property <string> up-num: "0";
    in property <string> up-unit: "Б/с";
    in property <string> down-path: "M0 27 L100 27";
    in property <string> up-path: "M0 27 L100 27";
    in property <string> totals: "—";
    in property <string> conns: "—";
    in property <string> down-total;
    in property <string> up-total;
    in property <int> final-action: 0;

    callback toggle-connection();
    callback set-mode(int);

    // ---- Рамка окна ----
    in property <bool> frameless: false;
    /// Радиус углов окна (Linux; на Windows углы скругляет система).
    property <length> corner: root.frameless ? 12px : 0px;
    /// Поля под тень вокруг окна (Linux).
    property <length> pad: root.frameless ? 16px : 0px;
    in property <int> close-action: 0;   // 0 трей, 1 панель задач, 2 выход
    callback set-close-action(int);
    callback quit-app();
    callback start-drag();
    callback minimize();
    callback close-window();

    // ---- Редактор сервера ----
    in-out property <int> servers-view: 0;  // 0 — список, 1 — редактор
    // ---- Соединения (на главной) ----
    in-out property <int> home-view: 0;     // 0 — главная, 1 — соединения
    in property <[ConnRow]> conn-rows;
    in property <string> conn-title;
    in property <string> conn-note;
    callback open-conns();
    callback close-conns();
    callback conn-search(string);
    callback conn-close(string);
    in property <bool> edit-new: false;
    in property <int> edit-proto: 0;        // 0 VLESS, 1 Hysteria2
    in property <[FieldItem]> edit-fields;
    in property <string> edit-error;
    callback edit-server(int);
    callback new-server();
    callback set-edit-proto(int);
    callback edit-field(int, string);
    callback save-server();

    // ---- Серверы ----
    in property <[Row]> rows;
    in property <bool> no-servers: true;
    in-out property <int> editing-index: -1;
    in-out property <bool> adding: false;
    in-out property <string> add-text;
    in property <string> add-error;
    in property <string> toast;

    callback select-server(int);
    callback remove-server(int);
    callback rename-server(int, string);
    callback copy-link(int);
    callback search(string);
    callback toggle-group(string);
    callback refresh-group(string);
    callback rename-group(string, string);
    callback copy-sub-link(string);
    callback toggle-fav(int);
    callback remove-sub-key(string);
    in-out property <string> editing-group: "";
    callback ping-all();
    callback open-add();
    callback add-links(string);
    callback read-clipboard() -> string;

    // ---- Правила ----
    in property <[RuleCard]> rule-cards;
    in property <[RuleCard]> rule-cards-own;
    in-out property <int> rules-view: 0;   // 0 — списки, 1 — один список
    in property <int> list-sel: -1;
    in property <string> list-name;
    in property <bool> list-builtin;
    /// Zapret включён — список «Через zapret» действует (иначе его адреса идут как всё остальное).
    in property <bool> zapret-routing: false;
    in property <bool> picking-set: false;
    in property <[SetRow]> set-rows;
    callback open-set-picker();
    callback set-filter(string);
    callback set-chosen(int);
    callback close-set-picker();
    in property <bool> list-enabled;
    in property <int> list-action;
    in property <[EntryItem]> entries;
    in-out property <bool> editing-list-name: false;
    in property <bool> picking: false;
    in property <[string]> processes;

    callback open-list(int);
    callback add-list();
    callback card-enabled(int, bool);
    callback set-list-enabled(bool);
    callback set-list-action(int);
    callback rename-list(string);
    callback delete-list();
    callback add-entry(string);
    callback remove-entry(int);
    callback toggle-zap-build();
    callback pick-process();
    callback process-filter(string);
    callback process-chosen(string);
    callback close-picker();

    // ---- Настройки ----
    in-out property <int> settings-view: 0; // 0 — настройки, 1 — журнал, 2 — zapret, 3 — обновление
    /// Страницу zapret открыли с главной — «назад» ведёт на главную.
    in-out property <bool> zapret-from-home: false;
    /// Список правил открыли с главной (строка zapret в «Трафике») — «назад» ведёт на главную.
    in-out property <bool> list-from-home: false;
    // ---- Zapret ----
    in property <bool> zapret-supported: false;
    in property <bool> zapret-enabled: false;
    in property <bool> zapret-installed: false;
    in property <string> zapret-info;
    in property <string> zapret-status;
    in property <bool> zapret-status-bad: false;
    in property <string> zapret-short;
    in property <[ZapretRow]> zapret-rows;
    in property <bool> zapret-testing: false;
    in property <string> zapret-progress;
    in property <bool> zapret-busy: false;
    in property <bool> zapret-update: false;
    callback zapret-toggled(bool);
    in property <bool> zapret-autostart: true;
    callback zapret-autostart-toggled(bool);
    callback zapret-select(int);
    callback zapret-test();
    callback zapret-cancel-test();
    callback zapret-download();
    callback zapret-open-folder();
    in property <bool> lan-bypass: true;
    in property <bool> remote-direct: true;
    in property <bool> autostart: false;
    in property <string> autostart-title: "Запускать вместе с Windows";
    in property <bool> connect-on-start: false;
    in-out property <bool> dns-custom;
    in-out property <string> dns-address;
    in property <string> dns-note;
    in property <bool> dns-note-bad;
    callback dns-custom-toggled(bool);
    callback dns-address-edited(string);
    in property <[SubItem]> subs;
    in property <string> settings-message;
    in property <string> log-text;
    in property <string> version: "";
    // ---- Обновление ----
    in property <string> app-version;
    in property <string> update-status;
    in property <bool> update-bad: false;
    in property <bool> update-busy: false;
    in property <bool> update-available: false;
    in property <string> update-latest;       // новая версия («» — нет)
    in property <string> update-checked;      // «проверено 5 мин назад»
    in property <[ReleaseRow]> releases;
    callback open-update();
    in property <int> zapret-test-pos;
    in property <int> zapret-test-total;
    in property <string> zapret-test-title;
    in property <string> zapret-user-sub;
    callback zapret-toggle-more();
    callback open-zapret-list();
    callback update-check();
    callback update-install();

    callback lan-bypass-toggled(bool);
    callback remote-direct-toggled(bool);
    callback autostart-toggled(bool);
    callback connect-on-start-toggled(bool);
    callback refresh-sub(int);
    callback remove-sub(int);
    callback open-folder();
    callback open-rules-file();
    callback clear-log();
    callback open-log();

    // Всё содержимое — внутри скруглённой «рамки»: и фон, и выезжающие панели обрезаются по углам.
    Rectangle {
    x: root.pad;
    y: root.pad;
    width: root.width - 2 * root.pad;
    height: root.height - 2 * root.pad;
    background: Theme.bg;
    border-radius: root.corner;
    clip: root.frameless;
    drop-shadow-blur: root.frameless ? 16px : 0px;
    drop-shadow-offset-y: root.frameless ? 3px : 0px;
    drop-shadow-color: #000000c8;

    VerticalLayout {
        // ================= Своя полоса заголовка =================
        Rectangle {
            height: 26px;
            TouchArea {
                pointer-event(ev) => {
                    if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                        root.start-drag();
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                // 4px + 4px внутри кнопки = 8px от правого края, как и сверху.
                padding-right: 4px;
                CaptionButton { icon: Icons.dash; dot: Theme.accent; clicked => { root.minimize(); } }
                CaptionButton { icon: Icons.cross-small; dot: #ec5f53; clicked => { root.close-window(); } }
            }
        }

        // ================= Содержимое вкладки =================
        Rectangle {
            vertical-stretch: 1;

            // ---------- Главная ----------
            if root.tab == 0 && root.home-view == 0: Page {
 VerticalLayout {
                padding: 16px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 8px;
                    height: 32px;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../icon.svg");
                            width: 28px;
                            height: 28px;
                            image-fit: contain;
                            image-rendering: smooth;
                        }
                    }
                    Text { text: "Foxray"; font-size: 21px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    // Вышла новая версия — плашка, нажатие открывает «Обновление».
                    if root.update-available: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 24px;
                            width: uhl.preferred-width + 20px;
                            border-radius: 12px;
                            background: uta.has-hover ? #ff7a2f38 : #ff7a2f24;
                            animate background { duration: 120ms; }
                            uta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.settings-view = 0;
                                    root.zapret-from-home = false;
                                    root.tab = 3;
                                    root.open-update();
                                }
                            }
                            uhl := HorizontalLayout {
                                x: 10px;
                                spacing: 5px;
                                VerticalLayout { alignment: center; Icon { width: 12px; height: 12px; commands: Icons.download; tint: Theme.accent; } }
                                Text { text: "Обновление " + root.update-latest; color: Theme.accent; font-size: 11.5px; font-weight: 600; vertical-alignment: center; }
                            }
                        }
                    }
                }

                // ---- Плитка VPN ----
                Rectangle {
                    border-radius: 14px;
                    height: 78px;
                    background: root.state == 2 ? @linear-gradient(120deg, #1d3a2b 0%, #1c2028 65%)
                              : root.state == 3 ? @linear-gradient(120deg, #3a1f1f 0%, #1c2028 65%)
                              : root.state == 1 ? @linear-gradient(120deg, #3a3220 0%, #1c2028 65%)
                              : Theme.card;
                    CornerMasks { width: parent.width; height: parent.height; }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 12px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                h: 28px;
                                on: root.state == 1 || root.state == 2;
                                on-color: root.state == 2 ? Theme.ok : Theme.warn;
                                toggled => { root.toggle-connection(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            Text { text: "VPN"; font-size: 10.5px; color: Theme.muted; letter-spacing: 0.5px; }
                            Text { text: root.status-title; font-size: 16px; font-weight: 600; color: Theme.text; overflow: elide; }
                            Text {
                                text: root.state == 2 ? (root.cur-ping != "" ? root.uptime + " · " + root.cur-ping : root.uptime) : root.status-sub;
                                font-size: 11.5px;
                                color: root.state == 3 ? #ff9a90 : Theme.muted;
                                overflow: elide;
                            }
                        }
                        // Сервер — короткая метка (MSK, DE2…), нажатие открывает список
                        VerticalLayout {
                            alignment: center;
                            if root.has-server: TagButton { text: root.cur-tag; clicked => { root.tab = 1; } }
                            if !root.has-server: TagButton { text: "Выбрать сервер"; plain: true; clicked => { root.tab = 1; } }
                        }
                    }
                }

                // ---- Плитка zapret (Windows) ----
                if root.zapret-supported: Rectangle {
                    border-radius: 14px;
                    height: 78px;
                    background: root.zapret-enabled && !root.zapret-home-bad ? @linear-gradient(120deg, #2c2142 0%, #1c2028 65%)
                              : root.zapret-enabled ? @linear-gradient(120deg, #3a1f1f 0%, #1c2028 65%)
                              : Theme.card;
                    CornerMasks { width: parent.width; height: parent.height; }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 12px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                h: 28px;
                                on: root.zapret-enabled;
                                on-color: Theme.zap;
                                toggled(v) => { root.zapret-toggled(v); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            Text { text: "ZAPRET"; font-size: 10.5px; color: Theme.muted; letter-spacing: 0.5px; }
                            Text { text: root.zapret-home-title; font-size: 16px; font-weight: 600; color: Theme.text; overflow: elide; }
                            Text { text: root.zapret-home-sub; font-size: 11.5px; color: root.zapret-home-bad ? #ff9a90 : Theme.muted; overflow: elide; }
                        }
                        VerticalLayout {
                            alignment: center;
                            TagButton { text: root.zapret-home-strategy; clicked => { root.zapret-from-home = true; root.tab = 3; root.settings-view = 2; } }
                        }
                    }
                }

                // ---- Трафик: маршруты + «N соединений» ----
                Card {
                    VerticalLayout {
                        // Заголовок и кнопка — в углах карточки: по 10px от верха и краёв.
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 10px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 4px;
                            height: 42px;
                            VerticalLayout { alignment: center; Text { text: "Трафик"; color: Theme.muted; font-size: 12px; } }
                            VerticalLayout {
                                alignment: center;
                                InfoDot { tip: "Куда идёт трафик. Метка справа — маршрут: VPN, zapret, напрямую или блок. Серая — сейчас не действует (например, VPN выключен).\n\nПод названием — сколько соединений открыто сейчас и сколько через них прошло.\n\nНажатие на «Всё остальное» переключает: всё через VPN ⇄ через VPN только списки. Остальные строки открывают свои настройки."; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            // «N соединений ›» — список соединений.
                            if root.state == 2 && root.conns != "—": VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 22px;
                                    width: cl.preferred-width;
                                    border-radius: 6px;
                                    background: cca.pressed ? #ffffff2a : cca.has-hover ? #ffffff22 : #ffffff14;
                                    animate background { duration: 120ms; }
                                    cca := TouchArea { mouse-cursor: pointer; clicked => { root.open-conns(); } }
                                    cl := HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 4px;
                                        spacing: 2px;
                                        Text { text: root.conns; font-size: 11.5px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                                        VerticalLayout { alignment: center; Icon { width: 12px; height: 12px; commands: Icons.right; tint: cca.has-hover ? Theme.text : Theme.muted; } }
                                    }
                                }
                            }
                        }
                        for r[i] in root.routes: Rectangle {
                            height: r.sub != "" ? 46px : 40px;
                            background: rrta.has-hover ? #ffffff06 : transparent;
                            rrta := TouchArea { mouse-cursor: pointer; clicked => { root.route-clicked(r.target); } }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    Text { text: r.title; font-size: 13px; color: r.kind == 4 ? Theme.muted : Theme.text; overflow: elide; }
                                    if r.sub != "": Text { text: r.sub; font-size: 10.5px; color: Theme.dim; overflow: elide; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 20px;
                                        width: chip.preferred-width + 16px;
                                        border-radius: 10px;
                                        background: r.kind == 0 ? #5b8cff22 : r.kind == 1 ? #a970ff22 : r.kind == 2 ? #2fbf7122 : r.kind == 3 ? #ec6a5e22 : #ffffff10;
                                        chip := Text {
                                            text: r.chip;
                                            font-size: 11px;
                                            color: r.kind == 0 ? Theme.vpn : r.kind == 1 ? Theme.zap : r.kind == 2 ? Theme.ok : r.kind == 3 ? Theme.bad : Theme.muted;
                                        }
                                    }
                                }
                            }
                            // Разделитель — и сверху (от заголовка), и между строками.
                            Rectangle { y: 0px; height: 1px; x: 12px; width: parent.width - 12px; background: #222731; }
                        }
                    }
                }

                // ---- Скорость ----
                HorizontalLayout {
                    spacing: 10px;
                    SpeedCard {
                        label: "Загрузка";
                        arrow: "↓";
                        tint: Theme.ok;
                        num: root.down-num;
                        unit: root.down-unit;
                        path: root.down-path;
                        word: "скачано";
                        total: root.state == 2 ? root.down-total : "";
                    }
                    SpeedCard {
                        label: "Отдача";
                        arrow: "↑";
                        tint: Theme.accent;
                        num: root.up-num;
                        unit: root.up-unit;
                        path: root.up-path;
                        word: "отправлено";
                        total: root.state == 2 ? root.up-total : "";
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }
            }

            // ---------- Соединения ----------
            if root.tab == 0 && root.home-view == 1: Page {
 VerticalLayout {
                padding: 16px;
                padding-top: 8px;
                padding-bottom: 0px; // список уходит прямо под вкладки
                spacing: 10px;
                Back { text: "Главная"; clicked => { root.close-conns(); } }
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "Соединения"; font-size: 21px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                    VerticalLayout {
                        alignment: center;
                        InfoDot { tip: "Все соединения, открытые сейчас через Foxray. Обновляется каждую секунду, сверху — те, что прокачали больше всего.\n\nМетка справа — куда пошло: VPN, zapret или напрямую. Крестик закрывает соединение (программа обычно сразу откроет новое — так можно проверить, куда оно пойдёт после смены правил)."; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.conn-title != "": VerticalLayout { alignment: center; Chip { text: root.conn-title; font-size: 11.5px; } }
                }
                Field {
                    placeholder-text: "Поиск: сайт, программа, VPN, zapret…";
                    edited(t) => { root.conn-search(t); }
                }
                if root.conn-note != "": VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    Text { text: root.conn-note; color: Theme.muted; horizontal-alignment: center; wrap: word-wrap; }
                }
                if root.conn-note == "": Rectangle {
                    vertical-stretch: 1;
                    // Свой Flickable с тонкой полосой прокрутки у края окна
                    // (стандартная полоса Slint рисуется поверх строк и «раскрывается»).
                    cfl := Flickable {
                        width: parent.width;
                        x: 0px;
                        content-height: cvl.preferred-height;
                        cvl := VerticalLayout {
                            alignment: start;
                            for c in root.conn-rows: Rectangle {
                                height: c.header ? 30px : 48px;
                                // Заголовок группы: «CLAUDE.EXE · 4»
                                if c.header: Text {
                                    x: 2px;
                                    y: parent.height - self.height - 6px;
                                    text: c.host;
                                    color: Theme.dim;
                                    font-size: 11px;
                                    letter-spacing: 0.6px;
                                }
                                // Соединение: строка карточки группы (скругления — у первой и последней).
                                if !c.header: Rectangle {
                                    background: crow.has-hover ? #20252e : Theme.card;
                                    border-top-left-radius: c.first ? 12px : 0px;
                                    border-top-right-radius: c.first ? 12px : 0px;
                                    border-bottom-left-radius: c.last ? 12px : 0px;
                                    border-bottom-right-radius: c.last ? 12px : 0px;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            min-width: 0px;
                                            // При наведении строка сужается под крестик — текст обрезается «…», не налезает.
                                            Text { text: c.host; color: Theme.text; font-size: 13px; overflow: elide; }
                                            Text { text: c.sub; color: Theme.dim; font-size: 10.5px; overflow: elide; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 3px;
                                            HorizontalLayout {
                                                alignment: end;
                                                Rectangle {
                                                    height: 18px;
                                                    width: rt.preferred-width + 14px;
                                                    border-radius: 9px;
                                                    background: c.kind == 0 ? #5b8cff22 : c.kind == 1 ? #a970ff22 : c.kind == 2 ? #2fbf7122 : #ffffff10;
                                                    rt := Text {
                                                        text: c.route;
                                                        font-size: 10.5px;
                                                        color: c.kind == 0 ? Theme.vpn : c.kind == 1 ? Theme.zap : c.kind == 2 ? Theme.ok : Theme.muted;
                                                    }
                                                }
                                            }
                                            Text { text: c.traffic; color: Theme.muted; font-size: 10.5px; horizontal-alignment: right; }
                                        }
                                        // Крестик выезжает при наведении и отодвигает метки влево.
                                        Rectangle {
                                            width: crow.has-hover ? 26px : 0px;
                                            animate width { duration: 120ms; easing: ease-out; }
                                            clip: true;
                                            Rectangle {
                                                x: 0px;
                                                width: 26px;
                                                height: 26px;
                                                border-radius: 6px;
                                                background: crow.mouse-x > crow.width - 36px ? #ec6a5e22 : transparent;
                                                Icon {
                                                    width: 15px;
                                                    height: 15px;
                                                    commands: Icons.close;
                                                    tint: crow.mouse-x > crow.width - 36px ? Theme.bad : Theme.dim;
                                                }
                                            }
                                        }
                                    }
                                    if !c.last: Rectangle {
                                        y: parent.height - 1px;
                                        height: 1px;
                                        x: 12px;
                                        width: parent.width - 12px;
                                        background: #222731;
                                    }
                                    // Один TouchArea на строку: и наведение, и нажатие на крестик.
                                    crow := TouchArea {
                                        mouse-cursor: self.has-hover && self.mouse-x > self.width - 36px ? pointer : default;
                                        clicked => {
                                            if self.mouse-x > self.width - 36px { root.conn-close(c.id); }
                                        }
                                    }
                                }
                            }
                            Rectangle { height: 8px; }
                        }
                    }
                    // Тонкая полоса прокрутки у правого края окна (в отступе страницы) — только если список не влезает.
                    if cfl.content-height > cfl.height: Rectangle {
                        x: parent.width + 16px - 7px;
                        width: 3px;
                        border-radius: 1.5px;
                        background: #ffffff2a;
                        height: max(24px, cfl.height * cfl.height / cfl.content-height);
                        y: (cfl.height - self.height) * (-cfl.content-y) / max(1px, cfl.content-height - cfl.height);
                    }
                }
            }
            }

            // ---------- Серверы ----------
            if root.tab == 1 && root.servers-view == 0: Page {
 VerticalLayout {
                padding: 16px;
                padding-top: 8px;
                padding-bottom: 0px; // список уходит прямо под вкладки
                spacing: 10px;

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Серверы"; font-size: 21px; font-weight: 700; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; height: 36px; }
                    VerticalLayout {
                        alignment: center;
                        IconButton { icon: Icons.plus; accent: true; size: 30px; clicked => { root.open-add(); } }
                    }
                }
                Field {
                    placeholder-text: "Поиск: страна, название, адрес…";
                    edited(t) => { root.search(t); }
                }
                if root.no-servers: VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 12px;
                    Text { text: "Серверов пока нет"; color: Theme.muted; font-size: 15px; horizontal-alignment: center; }
                    Text { text: "Вставь ссылку на сервер\nили подписку."; color: Theme.dim; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center;
                        Button2 { text: "Добавить сервер"; icon: Icons.plus; primary: true; clicked => { root.open-add(); } }
                    }
                }
                if !root.no-servers: Rectangle {
                    vertical-stretch: 1;
                    // Свой Flickable с тонкой полосой прокрутки у края окна — как в «Соединениях».
                    sfl := Flickable {
                        width: parent.width;
                        x: 0px;
                        content-height: svl.preferred-height;
                        svl := VerticalLayout {
                            alignment: start;
                            for r in root.rows: Rectangle {
                                // Между группами — отступ над шапкой (кроме самой первой).
                                height: r.kind == 0 ? 56px : 48px;
                                if r.kind == 0: GroupHeader {
                                    y: 10px;
                                    info: r;
                                    editing: r.key == root.editing-group && r.key != "";
                                    toggle => { root.toggle-group(r.key); }
                                    refresh => { root.refresh-group(r.key); }
                                    start-rename => { root.editing-group = r.key; }
                                    rename(t) => {
                                        root.rename-group(r.key, t);
                                        root.editing-group = "";
                                    }
                                    copy-link => { root.copy-sub-link(r.key); }
                                    remove => { root.remove-sub-key(r.key); }
                                }
                                if r.kind == 1: ServerRow {
                                    info: r;
                                    editing: r.index == root.editing-index;
                                    clicked => { root.select-server(r.index); }
                                    start-edit => { root.editing-index = r.index; }
                                    rename(t) => {
                                        root.rename-server(r.index, t);
                                        root.editing-index = -1;
                                    }
                                    copy-link => { root.copy-link(r.index); }
                                    open-editor => { root.edit-server(r.index); }
                                    remove => { root.remove-server(r.index); }
                                    toggle-fav => { root.toggle-fav(r.index); }
                                }
                            }
                            Rectangle { height: 8px; }
                        }
                    }
                    if sfl.content-height > sfl.height: Rectangle {
                        x: parent.width + 16px - 7px;
                        width: 3px;
                        border-radius: 1.5px;
                        background: #ffffff2a;
                        height: max(24px, sfl.height * sfl.height / sfl.content-height);
                        y: (sfl.height - self.height) * (-sfl.content-y) / max(1px, sfl.content-height - sfl.height);
                    }
                }
            }
            }

            // ---------- Серверы: редактор ----------
            if root.tab == 1 && root.servers-view == 1: Page {
                VerticalLayout {
                    padding: 16px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 10px;
                    Back { text: "Серверы"; clicked => { root.servers-view = 0; } }
                    Text {
                        text: root.edit-new ? "Новый сервер" : "Изменить сервер";
                        font-size: 21px;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    if root.edit-new: Segmented {
                        items: ["VLESS", "Hysteria2"];
                        current: root.edit-proto;
                        changed(i) => { root.set-edit-proto(i); }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 10px;
                            alignment: start;
                            padding-right: 6px;
                            for f[i] in root.edit-fields: VerticalLayout {
                                spacing: 4px;
                                if f.kind != 1: Text { text: f.label; color: Theme.muted; font-size: 11.5px; }
                                if f.kind == 0: Field {
                                    text: f.value;
                                    edited(t) => { root.edit-field(i, t); }
                                }
                                if f.kind == 2: Segmented {
                                    items: f.labels;
                                    current: f.choice;
                                    changed(c) => { root.edit-field(i, c); }
                                }
                                if f.kind == 1: Card {
                                    height: 44px;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            Text { text: f.label; color: Theme.text; font-size: 13px; }
                                            if f.hint != "": Text { text: f.hint; color: Theme.dim; font-size: 11px; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Switch {
                                                on: f.value == "1";
                                                toggled(v) => { root.edit-field(i, v ? "1" : ""); }
                                            }
                                        }
                                    }
                                }
                                if f.kind == 0 && f.hint != "": Hint { text: f.hint; }
                            }
                        }
                    }
                    if root.edit-error != "": Hint { text: root.edit-error; bad: true; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button2 { text: "Отмена"; horizontal-stretch: 1; clicked => { root.servers-view = 0; } }
                        Button2 { text: "Сохранить"; primary: true; horizontal-stretch: 1; clicked => { root.save-server(); } }
                    }
                }
            }

            // ---------- Правила: все списки ----------
            if root.tab == 2 && root.rules-view == 0: Page {
 VerticalLayout {
                padding: 16px;
                padding-top: 8px;
                padding-bottom: 0px; // список уходит прямо под вкладки
                spacing: 0px;

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Правила"; font-size: 21px; font-weight: 700; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; height: 36px; }
                    VerticalLayout {
                        alignment: center;
                        IconButton { icon: Icons.plus; accent: true; size: 30px; clicked => { root.add-list(); } }
                    }
                }

                Flickable {
                    vertical-stretch: 1;
                    content-height: rvl.preferred-height;
                    rvl := VerticalLayout {
                        alignment: start;
                        VerticalLayout { padding-top: 12px; padding-bottom: 6px; padding-left: 2px; SectionHead { text: "БАЗОВЫЕ СПИСКИ"; } }
                        for c in root.rule-cards: RuleListRow {
                            card: c;
                            open => { root.open-list(c.index); }
                            toggled(v) => { root.card-enabled(c.index, v); }
                        }
                        if root.rule-cards-own.length > 0: VerticalLayout { padding-top: 16px; padding-bottom: 6px; padding-left: 2px; SectionHead { text: "СВОИ СПИСКИ"; } }
                        for c in root.rule-cards-own: RuleListRow {
                            card: c;
                            first: c.index == root.rule-cards-own[0].index;
                            open => { root.open-list(c.index); }
                            toggled(v) => { root.card-enabled(c.index, v); }
                        }
                        Rectangle { height: 8px; }
                    }
                }
            }
            }

            // ---------- Правила: один список ----------
            if root.tab == 2 && root.rules-view == 1: Page {
 VerticalLayout {
                padding: 16px;
                padding-top: 8px;
                padding-bottom: 0px; // список уходит прямо под вкладки
                spacing: 10px;

                Back {
                    text: root.list-from-home ? "Главная" : "Правила";
                    clicked => {
                        if (root.list-from-home) { root.tab = 0; }
                        root.rules-view = 0;
                        root.editing-list-name = false;
                        root.list-from-home = false;
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    if !root.editing-list-name: Text {
                        text: root.list-name;
                        font-size: 21px;
                        font-weight: 700;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if !root.editing-list-name && root.list-builtin: VerticalLayout {
                        alignment: center;
                        InfoDot {
                            tip: root.list-action == 3
                                ? "Домены и адреса идут мимо VPN, а zapret обходит для них блокировку. Если zapret выключен — они идут как всё остальное (обычно через VPN). Этот список важнее «Напрямую» и «Через VPN». Готовые наборы тоже можно; программы — нет: zapret работает по адресам. IP-адреса подхватывают не все стратегии."
                                : (root.list-action == 0 ? "Базовый список: всё из него идёт через VPN."
                                : root.list-action == 1 ? "Базовый список: всё из него идёт напрямую, мимо VPN."
                                : "Базовый список: всё из него блокируется.")
                                + " Его нельзя удалить — только выключить или очистить.";
                        }
                    }
                    if !root.editing-list-name: Rectangle { horizontal-stretch: 1; }
                    if root.editing-list-name: Field {
                        horizontal-stretch: 1;
                        text: root.list-name;
                        accepted(t) => {
                            root.rename-list(t);
                            root.editing-list-name = false;
                        }
                        init => {
                            self.focus();
                            self.select-all();
                        }
                    }
                    if !root.editing-list-name && !root.list-builtin: VerticalLayout {
                        alignment: center;
                        GhostIcon { icon: Icons.edit; clicked => { root.editing-list-name = true; } }
                    }
                    if !root.list-builtin: VerticalLayout {
                        alignment: center;
                        GhostIcon { icon: Icons.trash; hover-tint: Theme.bad; clicked => { root.delete-list(); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        Switch { on: root.list-enabled; on-color: root.list-action == 3 ? Theme.zap : Theme.accent; toggled(v) => { root.set-list-enabled(v); } }
                    }
                }
                if !root.list-builtin: Segmented {
                    items: ["через VPN", "напрямую", "блок"];
                    current: root.list-action;
                    changed(i) => { root.set-list-action(i); }
                }

                HorizontalLayout {
                    spacing: 8px;
                    entry-edit := Field {
                        placeholder-text: root.list-action == 3 ? "rutracker.org, 104.16.0.0/13…" : "vk.com, 10.0.0.0/8, steam.exe…";
                        accepted(t) => {
                            root.add-entry(t);
                            self.text = "";
                        }
                    }
                    IconButton {
                        icon: Icons.plus;
                        accent: true;
                        size: 36px;
                        clicked => {
                            root.add-entry(entry-edit.text);
                            entry-edit.text = "";
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    if root.list-action != 3: Button2 { text: "Программа"; icon: Icons.app; horizontal-stretch: 1; clicked => { root.pick-process(); } }
                    Button2 { text: "Готовый набор"; icon: Icons.layers; horizontal-stretch: 1; clicked => { root.open-set-picker(); } }
                }
                // Своих записей нет (первая строка — уже шапка «Из сборки zapret»).
                if root.entries.length == 0 || root.entries[0].icon == 5: Hint {
                    text: root.list-action == 3 ? "Список пуст. Добавь домен, IP, подсеть или готовый набор."
                        : "Список пуст. Добавь домен, IP, подсеть, программу или готовый набор.";
                }
                // Новый пустой список — сразу предлагаем готовый набор.
                if root.entries.length == 0 && !root.list-builtin: Card {
                    height: 64px;
                    background: sta2.has-hover ? Theme.card2 : Theme.card;
                    animate background { duration: 120ms; }
                    sta2 := TouchArea { mouse-cursor: pointer; clicked => { root.open-set-picker(); } }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 34px;
                                height: 34px;
                                border-radius: 9px;
                                background: #ff7a2f22;
                                Icon { width: 18px; height: 18px; commands: Icons.layers; tint: Theme.accent; }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text { text: "Начать с готового набора"; color: Theme.text; font-size: 13.5px; font-weight: 600; }
                            Text { text: "YouTube, Discord, Telegram и другие сервисы"; color: Theme.dim; font-size: 11px; overflow: elide; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Icon { width: 16px; height: 16px; commands: Icons.right; tint: Theme.dim; }
                        }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    efl := Flickable {
                        width: parent.width;
                        x: 0px;
                        content-height: evl.preferred-height;
                        evl := VerticalLayout {
                            alignment: start;
                            for e[i] in root.entries: EntryRow {
                                item: e;
                                remove => { root.remove-entry(i); }
                                toggle => { root.toggle-zap-build(); }
                            }
                            Rectangle { height: 8px; }
                        }
                    }
                    if efl.content-height > efl.height: Rectangle {
                        x: parent.width + 16px - 7px;
                        width: 3px;
                        border-radius: 1.5px;
                        background: #ffffff2a;
                        height: max(24px, efl.height * efl.height / efl.content-height);
                        y: (efl.height - self.height) * (-efl.content-y) / max(1px, efl.content-height - efl.height);
                    }
                }
            }
            }

            // ---------- Настройки ----------
            // Единый стиль: заголовок раздела → карточка → подсказка под карточкой.
            // В строке — коротко (одна строка), всё длинное и ошибки — в подсказке.
            if root.tab == 3 && root.settings-view == 0: Page {
 ssv := ScrollView {
                VerticalLayout {
                    width: ssv.visible-width;
                    padding: 16px;
                    padding-top: 8px;
                    padding-bottom: 16px;
                    spacing: 18px;
                    alignment: start;

                    Text { text: "Настройки"; font-size: 21px; font-weight: 700; color: Theme.text; height: 36px; vertical-alignment: center; }

                    Group {
                        Section { text: "СЕТЬ"; }
                        Card {
                            VerticalLayout {
                                IRow {
                                    first: true;
                                    icon: Icons.lan;
                                    tint: Theme.ok;
                                    title: "Не трогать локальную сеть";
                                    subtitle: "роутер, NAS, принтеры — мимо VPN";
                                    VerticalLayout { alignment: center; Switch { on: root.lan-bypass; toggled(v) => { root.lan-bypass-toggled(v); } } }
                                }
                                IRow {
                                    icon: Icons.monitor;
                                    tint: Theme.ok;
                                    title: "Удалённый доступ напрямую";
                                    subtitle: root.remote-direct ? "RDP — мимо VPN, на любом порту" : "RDP идёт как всё остальное";
                                    tip: "Программы удалённого рабочего стола идут мимо VPN — на любом порту:\nWindows: mstsc, «Удалённый рабочий стол»\nLinux: FreeRDP, Remmina, KRDC, GNOME Connections\nи всё, что подключается на порт 3389.\n\nСвой порт (например 19960) — запись port:19960 в списке «Напрямую».";
                                    VerticalLayout { alignment: center; Switch { on: root.remote-direct; toggled(v) => { root.remote-direct-toggled(v); } } }
                                }
                                IRow {
                                    icon: Icons.dns;
                                    tint: Theme.vpn;
                                    title: "Свой DNS-сервер";
                                    subtitle: root.dns-custom ? "AdGuard Home, Pi-hole и т. п." : "сейчас 1.1.1.1 через VPN";
                                    last: !root.dns-custom;
                                    VerticalLayout { alignment: center; Switch { on: root.dns-custom; toggled(v) => { root.dns-custom-toggled(v); } } }
                                }
                                if root.dns-custom: VerticalLayout {
                                    padding: 12px;
                                    padding-top: 4px;
                                    padding-left: 50px;
                                    Field {
                                        inset: true;
                                        text <=> root.dns-address;
                                        edited(t) => { root.dns-address-edited(t); }
                                    }
                                }
                            }
                        }
                        if root.dns-custom && root.dns-note != "": Hint { text: root.dns-note; bad: root.dns-note-bad; }
                    }

                    if root.zapret-supported: Group {
                        Section { text: "ОБХОД БЛОКИРОВОК"; }
                        Card {
                            IRow {
                                first: true;
                                last: true;
                                clickable: true;
                                icon: Icons.bolt;
                                tint: Theme.zap;
                                title: "Zapret";
                                subtitle: root.zapret-short;
                                clicked => { root.zapret-from-home = false; root.settings-view = 2; }
                                Chevron { }
                            }
                        }
                    }

                    Group {
                        Section { text: "ЗАПУСК"; }
                        Card {
                            VerticalLayout {
                                IRow {
                                    first: true;
                                    icon: Icons.power;
                                    tint: Theme.accent;
                                    title: root.autostart-title;
                                    subtitle: "в свёрнутом виде";
                                    VerticalLayout { alignment: center; Switch { on: root.autostart; toggled(v) => { root.autostart-toggled(v); } } }
                                }
                                IRow {
                                    last: true;
                                    icon: Icons.refresh;
                                    tint: Theme.accent;
                                    title: "Подключаться при запуске";
                                    subtitle: "если сети ещё нет — подождёт её";
                                    VerticalLayout { alignment: center; Switch { on: root.connect-on-start; toggled(v) => { root.connect-on-start-toggled(v); } } }
                                }
                            }
                        }
                        if root.settings-message != "": Hint { text: root.settings-message; bad: true; }
                    }

                    Group {
                        SectionHead {
                            text: "КНОПКА «ЗАКРЫТЬ»";
                            tip: "В трей — окно прячется, Foxray остаётся в трее у часов.\nВ панель задач — окно сворачивается, иконки в трее нет. Выйти — правой кнопкой по значку в панели задач.\nВыход — Foxray закрывается полностью, VPN отключается.";
                        }
                        Segmented {
                            items: ["В трей", "В панель задач", "Выход"];
                            current: root.close-action;
                            changed(i) => { root.set-close-action(i); }
                        }
                    }

                    Group {
                        Section { text: "FOXRAY"; }
                        Card {
                            VerticalLayout {
                                IRow {
                                    first: true;
                                    clickable: true;
                                    icon: Icons.download;
                                    tint: Theme.accent;
                                    title: "Обновление";
                                    subtitle: root.update-available ? "доступна " + root.update-latest + " · установлена " + root.app-version : "установлена " + root.app-version;
                                    clicked => { root.open-update(); }
                                    if root.update-available: VerticalLayout { alignment: center; Chip { text: root.update-latest; tint: Theme.accent; } }
                                    Chevron { }
                                }
                                IRow {
                                    clickable: true;
                                    icon: Icons.log;
                                    title: "Журнал";
                                    clicked => { root.open-log(); }
                                    Chevron { }
                                }
                                IRow {
                                    last: true;
                                    clickable: true;
                                    icon: Icons.folder;
                                    title: "Папка программы";
                                    subtitle: "серверы, настройки, rules.json";
                                    clicked => { root.open-folder(); }
                                    Chevron { }
                                }
                            }
                        }
                    }

                    Card {
                        IRow {
                            first: true;
                            last: true;
                            clickable: true;
                            icon: Icons.exit;
                            tint: Theme.bad;
                            title: "Выйти из Foxray";
                            title-color: Theme.bad;
                            subtitle: "отключить VPN и закрыть программу";
                            clicked => { root.quit-app(); }
                        }
                    }
                }
            }
            }

            // ---------- Журнал ----------
            if root.tab == 3 && root.settings-view == 1: Page {
 VerticalLayout {
                padding: 16px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 10px;
                Back { text: "Настройки"; clicked => { root.settings-view = 0; } }
                HorizontalLayout {
                    Text { text: "Журнал"; font-size: 21px; font-weight: 700; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                    Button2 { text: "Очистить"; clicked => { root.clear-log(); } }
                }
                Area {
                    vertical-stretch: 1;
                    read-only: true;
                    font-size: 11px;
                    text: root.log-text;
                }
            }
            }

            // ---------- Обновление ----------
            if root.tab == 3 && root.settings-view == 3: Page {
 usv := ScrollView {
                VerticalLayout {
                    width: usv.visible-width;
                    padding: 16px;
                    padding-top: 8px;
                    padding-bottom: 16px;
                    spacing: 12px;
                    alignment: start;
                    VerticalLayout {
                        spacing: 10px;
                        Back { text: "Настройки"; clicked => { root.settings-view = 0; } }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text { text: "Обновление"; font-size: 21px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                            VerticalLayout {
                                alignment: center;
                                InfoDot { tip: "Foxray проверяет новые версии на GitHub при запуске. «Обновить» скачивает новую версию, заменяет программу и sing-box и перезапускает Foxray. Серверы, подписки, настройки и правила остаются, VPN на время обновления отключится."; }
                            }
                        }
                    }
                    // Карточка версии: что стоит, что есть, кнопка.
                    Rectangle {
                        border-radius: 14px;
                        background: root.update-available ? @linear-gradient(120deg, #2c2016 0%, #1c2028 70%) : Theme.card;
                        CornerMasks { width: parent.width; height: parent.height; }
                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    Image { source: @image-url("../icon.svg"); width: 40px; height: 40px; image-fit: contain; image-rendering: smooth; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: root.update-available ? "Доступна " + root.update-latest : "Foxray " + root.app-version;
                                        font-size: 17px;
                                        font-weight: 700;
                                        color: Theme.text;
                                    }
                                    // Две строки: что стоит / когда проверяли — в одну не влезает.
                                    Text {
                                        text: root.update-busy ? "минутку…"
                                            : root.update-available ? "у тебя " + root.app-version
                                            : root.update-bad ? "не удалось проверить" : root.update-checked == "" ? "ещё не проверялось" : "установлена последняя версия";
                                        font-size: 11.5px;
                                        color: root.update-bad ? Theme.bad : Theme.muted;
                                        overflow: elide;
                                    }
                                    if root.update-checked != "" && !root.update-busy: Text {
                                        text: root.update-checked;
                                        font-size: 10.5px;
                                        color: Theme.dim;
                                        overflow: elide;
                                    }
                                }
                            }
                            Button2 {
                                text: root.update-busy ? (root.update-available ? "Обновляю…" : "Проверяю…") : root.update-available ? "Обновить до " + root.update-latest : "Проверить";
                                primary: root.update-available && !root.update-busy;
                                raised: !root.update-available;
                                clicked => {
                                    if !root.update-busy {
                                        if root.update-available { root.update-install(); } else { root.update-check(); }
                                    }
                                }
                            }
                        }
                    }
                    if root.update-bad: Hint { text: root.update-status; bad: true; }

                    if root.releases.length > 0: VerticalLayout {
                        padding-top: 6px;
                        Section { text: "ЧТО НОВОГО"; }
                    }
                    for r in root.releases: Rectangle {
                        border-radius: 12px;
                        background: Theme.card;
                        opacity: r.is-new || r.installed ? 1 : 0.8;
                        VerticalLayout {
                            padding: 12px;
                            padding-bottom: 10px;
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: r.version; font-size: 13.5px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                                if r.is-new: VerticalLayout { alignment: center; Chip { text: "новая"; tint: Theme.accent; } }
                                if r.installed: VerticalLayout { alignment: center; Chip { text: "установлена"; } }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: r.date; font-size: 10.5px; color: Theme.dim; vertical-alignment: center; }
                            }
                            // Высота строки — по тексту с переносами: ширина задана явно, иначе Slint
                            // считает перенесённый текст одной строкой и список не долистывается.
                            for n in r.notes: Rectangle {
                                height: nt.preferred-height;
                                Text { x: 0; y: 0; text: "•"; color: Theme.dim; font-size: 12px; }
                                nt := Text { x: 12px; y: 0; width: parent.width - 12px; text: n; color: #c9ced8; font-size: 12px; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }
            }

            // ---------- Zapret ----------
            if root.tab == 3 && root.settings-view == 2: Page {
 zsv := ScrollView {
                VerticalLayout {
                    width: zsv.visible-width;
                    padding: 16px;
                    padding-top: 8px;
                    // Запас снизу: высоту многострочных подсказок Slint считает по одной строке.
                    padding-bottom: 40px;
                    spacing: 12px;
                    alignment: start;

                    VerticalLayout {
                        spacing: 10px;
                        Back {
                            text: root.zapret-from-home ? "Главная" : "Настройки";
                            clicked => {
                                if (root.zapret-from-home) { root.tab = 0; }
                                root.settings-view = 0;
                                root.zapret-from-home = false;
                            }
                        }
                        Text { text: "Zapret"; font-size: 21px; font-weight: 700; color: Theme.text; }
                    }

                    // Состояние и главный переключатель — как плитка на главной.
                    Rectangle {
                        border-radius: 14px;
                        height: 74px;
                        background: root.zapret-enabled && !root.zapret-home-bad ? @linear-gradient(120deg, #2c2142 0%, #1c2028 70%)
                                  : root.zapret-enabled ? @linear-gradient(120deg, #3a1f1f 0%, #1c2028 70%)
                                  : Theme.card;
                        CornerMasks { width: parent.width; height: parent.height; }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 34px;
                                    height: 34px;
                                    border-radius: 10px;
                                    background: #a970ff24;
                                    Icon { width: 17px; height: 17px; commands: Icons.bolt; tint: Theme.zap; }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                Text { text: root.zapret-home-title; font-size: 16px; font-weight: 700; color: Theme.text; overflow: elide; }
                                Text {
                                    text: root.zapret-enabled && !root.zapret-home-bad ? "Discord с голосом, YouTube и твой список — мимо VPN"
                                        : root.zapret-enabled ? root.zapret-home-sub : "Discord и YouTube без VPN";
                                    font-size: 11px;
                                    color: root.zapret-home-bad ? #ff9a90 : Theme.muted;
                                    overflow: elide;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Switch { h: 24px; on: root.zapret-enabled; on-color: Theme.zap; toggled(v) => { root.zapret-toggled(v); } }
                            }
                        }
                    }
                    if root.zapret-status != "": Hint { text: root.zapret-status; bad: root.zapret-status-bad; }

                    Card {
                        IRow {
                            first: true;
                            last: true;
                            clickable: true;
                            icon: Icons.star;
                            tint: Theme.zap;
                            title: "Свои сайты";
                            subtitle: root.zapret-user-sub;
                            clicked => { root.open-zapret-list(); }
                            Chevron { }
                        }
                    }

                    if root.zapret-installed: VerticalLayout {
                        spacing: 8px;
                        padding-top: 6px;
                        SectionHead {
                            text: "СТРАТЕГИЯ";
                            tip: "«Подобрать стратегию»: Foxray по очереди включает каждую стратегию и открывает 7 адресов Discord и YouTube (1–3 минуты).\n\n7/7 · 155 мс — открылось 7 из 7, среднее время ответа.\nЗелёный — открылось всё, жёлтый — часть, красный — ничего.\n\nГолос так не проверить: выбери одну из лучших и зайди в голосовой канал. Не работает голос — бери следующую.";
                        }
                        // Подбор: кнопка или карточка с ходом проверки.
                        if !root.zapret-testing: Rectangle {
                            height: 38px;
                            border-radius: 10px;
                            background: zta.has-hover ? #b788ff : Theme.zap;
                            animate background { duration: 120ms; }
                            zta := TouchArea { mouse-cursor: pointer; clicked => { root.zapret-test(); } }
                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                VerticalLayout { alignment: center; Icon { width: 15px; height: 15px; commands: Icons.bolt; tint: white; } }
                                Text { text: "Подобрать стратегию"; color: white; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                            }
                        }
                        if root.zapret-testing: Card {
                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        Text {
                                            text: "Подбираю стратегию" + (root.zapret-test-total > 0 ? " · " + root.zapret-test-pos + "/" + root.zapret-test-total : "");
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.text;
                                        }
                                        Text { text: root.zapret-progress; font-size: 11px; color: Theme.dim; overflow: elide; }
                                    }
                                    VerticalLayout { alignment: center; Button2 { text: "Стоп"; raised: true; clicked => { root.zapret-cancel-test(); } } }
                                }
                                Rectangle {
                                    height: 5px;
                                    border-radius: 2.5px;
                                    background: #ffffff12;
                                    Rectangle {
                                        x: 0;
                                        width: root.zapret-test-total > 0 ? parent.width * root.zapret-test-pos / root.zapret-test-total : 0px;
                                        animate width { duration: 300ms; }
                                        border-radius: 2.5px;
                                        background: Theme.zap;
                                    }
                                }
                            }
                        }
                        if !root.zapret-testing && root.zapret-progress != "": Hint { text: root.zapret-progress; }
                        VerticalLayout {
                            for z in root.zapret-rows: Rectangle {
                                height: z.header ? 44px : 46px;
                                background: z.header ? (zra.has-hover ? #252a33 : #20242d)
                                    : z.state == 4 || z.selected ? #241d33 : (zra.has-hover && !root.zapret-testing ? #20252e : Theme.card);
                                animate background { duration: 120ms; }
                                border-top-left-radius: z.first ? 12px : 0px;
                                border-top-right-radius: z.first ? 12px : 0px;
                                border-bottom-left-radius: z.last ? 12px : 0px;
                                border-bottom-right-radius: z.last ? 12px : 0px;
                                if !z.first: Rectangle { y: 0; x: 12px; width: parent.width - 12px; height: 1px; background: #222731; }
                                if (z.selected || z.state == 4) && !z.header: Rectangle {
                                    x: 0px;
                                    y: 10px;
                                    width: 3px;
                                    height: parent.height - 20px;
                                    border-radius: 2px;
                                    background: Theme.zap;
                                }
                                zra := TouchArea {
                                    enabled: z.header || !root.zapret-testing;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if (z.header) { root.zapret-toggle-more(); } else { root.zapret-select(z.index); }
                                    }
                                }
                                if z.header: HorizontalLayout {
                                    padding-left: 12px;
                                    spacing: 8px;
                                    VerticalLayout { alignment: center; Icon { width: 13px; height: 13px; commands: z.selected ? Icons.down : Icons.right; tint: Theme.muted; } }
                                    Text { text: z.title; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                }
                                if !z.header: HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    VerticalLayout { alignment: center; Radio { on: z.selected; tint: Theme.zap; } }
                                    Text { text: z.title; color: Theme.text; font-size: 13px; font-weight: z.selected ? 600 : 400; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                    if z.result != "": VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            height: 18px;
                                            width: zt.preferred-width + 14px;
                                            border-radius: 9px;
                                            background: z.state == 1 ? #2fbf7122 : z.state == 2 ? #e7b43c22 : z.state == 3 ? #ec6a5e22 : z.state == 4 ? #a970ff22 : #ffffff10;
                                            zt := Text {
                                                text: z.result;
                                                font-size: 10.5px;
                                                color: z.state == 1 ? Theme.ok : z.state == 2 ? Theme.warn : z.state == 3 ? Theme.bad : z.state == 4 ? Theme.zap : Theme.muted;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        padding-top: 6px;
                        Section { text: "СБОРКА"; }
                        Card {
                            VerticalLayout {
                                IRow {
                                    first: true;
                                    icon: Icons.download;
                                    title: root.zapret-installed ? "Сборка Flowseal" : "Сборка zapret";
                                    subtitle: root.zapret-info;
                                    VerticalLayout {
                                        alignment: center;
                                        Button2 {
                                            text: root.zapret-busy ? "Скачиваю…" : !root.zapret-installed ? "Скачать" : root.zapret-update ? "Обновить" : "Проверить";
                                            raised: true;
                                            primary: !root.zapret-installed || root.zapret-update;
                                            clicked => { if !root.zapret-busy { root.zapret-download(); } }
                                        }
                                    }
                                }
                                IRow {
                                    icon: Icons.power;
                                    tint: Theme.accent;
                                    title: "Включать при запуске Foxray";
                                    subtitle: root.zapret-autostart ? "как был при выходе" : "после запуска — выключен";
                                    VerticalLayout { alignment: center; Switch { on: root.zapret-autostart; toggled(v) => { root.zapret-autostart-toggled(v); } } }
                                }
                                IRow {
                                    last: true;
                                    clickable: true;
                                    icon: Icons.folder;
                                    title: "Папка zapret";
                                    subtitle: "списки доменов, стратегии";
                                    clicked => { root.zapret-open-folder(); }
                                    Chevron { }
                                }
                            }
                        }
                    }
                }
            }
            }
        }

        // ================= Нижняя панель =================
        Rectangle {
            height: 60px;
            background: Theme.panel;
            Rectangle { y: 0; height: 1px; background: #1f232b; }
            HorizontalLayout {
                // Вкладка всегда открывается с первой страницы (и повторное нажатие тоже возвращает на неё).
                TabButton {
                    label: "Главная";
                    icon: Icons.power;
                    active: root.tab == 0;
                    clicked => {
                        if (root.home-view != 0) { root.close-conns(); }
                        root.tab = 0;
                    }
                }
                TabButton {
                    label: "Серверы";
                    icon: Icons.servers;
                    active: root.tab == 1;
                    clicked => {
                        root.servers-view = 0;
                        root.tab = 1;
                    }
                }
                TabButton {
                    label: "Правила";
                    icon: Icons.rules;
                    active: root.tab == 2;
                    clicked => {
                        root.rules-view = 0;
                        root.editing-list-name = false;
                        root.list-from-home = false;
                        root.tab = 2;
                    }
                }
                TabButton {
                    label: "Настройки";
                    icon: Icons.gear;
                    active: root.tab == 3;
                    clicked => {
                        root.settings-view = 0;
                        root.zapret-from-home = false;
                        root.tab = 3;
                    }
                }
            }
        }
    }

    // Тонкая обводка (у окна без рамки иначе сливается с фоном)
    Rectangle {
        border-width: 1px;
        border-color: #2a2f38;
        border-radius: root.corner;
    }

    // ================= Всплывающее уведомление =================
    if root.toast != "": Rectangle {
        y: parent.height - 60px - 52px;
        x: (parent.width - self.width) / 2;
        height: 36px;
        width: tt.preferred-width + 28px;
        border-radius: 18px;
        background: #2b313c;
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 180ms; }
        drop-shadow-blur: 12px;
        drop-shadow-color: #0008;
        tt := Text { text: root.toast; color: Theme.text; font-size: 12.5px; }
    }

    // ================= Подсказка «i» =================
    if Tip.text != "": Rectangle {
        // Tip.x/Tip.y — от угла окна, а эта рамка сдвинута на поля под тень.
        property <length> pw: root.width - 2 * root.pad;
        property <length> ph: root.height - 2 * root.pad;
        property <length> tx: Tip.x - root.pad;
        property <length> ty: Tip.y - root.pad;
        property <length> w: min(300px, self.pw - 32px);
        width: self.w;
        height: tipt.preferred-height + 20px;
        x: max(16px, min(self.tx - self.w / 2, self.pw - self.w - 16px));
        // Не влезает снизу — показываем над значком.
        y: self.ty + 6px + self.height < self.ph - 8px ? self.ty + 6px : max(8px, self.ty - 24px - self.height);
        border-radius: 10px;
        background: #2b313c;
        border-width: 1px;
        border-color: #39404d;
        drop-shadow-blur: 14px;
        drop-shadow-color: #000a;
        tipt := Text {
            x: 12px;
            y: 10px;
            width: parent.width - 24px;
            text: Tip.text;
            color: Theme.text;
            font-size: 12px;
            wrap: word-wrap;
        }
    }

    // ================= Панель «Добавить» =================
    if root.adding: Rectangle {
        background: #000000a0;
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 160ms; }
        TouchArea { clicked => { root.adding = false; root.add-text = ""; } }
        Rectangle {
            property <length> slide: 60px;
            init => { self.slide = 0; }
            animate slide { duration: 220ms; easing: ease-out; }
            y: parent.height - self.height + self.slide;
            height: sheet.preferred-height;
            background: Theme.panel;
            border-top-left-radius: 16px;
            border-top-right-radius: 16px;
            border-width: 1px;
            border-color: Theme.line;
            TouchArea { } // клики внутри панели не закрывают её
            sheet := VerticalLayout {
                padding: 16px;
                padding-top: 10px;
                spacing: 10px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle { width: 36px; height: 4px; border-radius: 2px; background: #3a414d; }
                }
                HorizontalLayout {
                    Text { text: "Добавить сервер"; font-size: 16px; font-weight: 600; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; }
                    GhostIcon { icon: Icons.close; clicked => { root.adding = false; root.add-text = ""; } }
                }
                VerticalLayout {
                    spacing: 6px;
                    Area {
                        height: 96px;
                        text <=> root.add-text;
                    }
                    if root.add-error != "": Hint { text: root.add-error; bad: true; }
                    if root.add-error == "": Hint { text: "Ссылка vless:// или hy2://, несколько ссылок сразу или подписка https://"; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button2 {
                        text: "Вручную";
                        icon: Icons.edit;
                        clicked => {
                            root.adding = false;
                            root.new-server();
                        }
                    }
                    Button2 {
                        text: "Из буфера";
                        icon: Icons.clip;
                        horizontal-stretch: 1;
                        clicked => { root.add-text = root.read-clipboard(); }
                    }
                    Button2 {
                        text: "Добавить";
                        primary: true;
                        horizontal-stretch: 1;
                        clicked => { root.add-links(root.add-text); }
                    }
                }
            }
        }
    }

    // ================= Выбор готового набора =================
    if root.picking-set: Rectangle {
        background: #000000a0;
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 160ms; }
        TouchArea { clicked => { root.close-set-picker(); } }
        Rectangle {
            x: 16px;
            y: 50px;
            width: parent.width - 32px;
            height: parent.height - 100px;
            border-radius: 14px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            TouchArea { }
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    Text { text: "Готовые наборы"; font-size: 15px; font-weight: 600; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; }
                    GhostIcon { icon: Icons.close; clicked => { root.close-set-picker(); } }
                }
                Field {
                    placeholder-text: "Поиск сервиса…";
                    edited(t) => { root.set-filter(t); }
                }
                ListView {
                    vertical-stretch: 1;
                    for r in root.set-rows: Rectangle {
                        height: r.kind == 0 ? 30px : 44px;
                        border-radius: 8px;
                        background: r.kind == 1 && sra.has-hover ? Theme.card2 : transparent;
                        animate background { duration: 120ms; }
                        sra := TouchArea {
                            enabled: r.kind == 1;
                            mouse-cursor: pointer;
                            clicked => { root.set-chosen(r.index); }
                        }
                        if r.kind == 0: Text {
                            x: 10px;
                            y: parent.height - self.height - 4px;
                            text: r.title;
                            color: Theme.dim;
                            font-size: 11px;
                        }
                        if r.kind == 1: HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text { text: r.title; color: Theme.text; font-size: 13px; overflow: elide; }
                                Text { text: r.sub; color: Theme.dim; font-size: 10.5px; overflow: elide; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: r.added ? Theme.accent : transparent;
                                    border-width: r.added ? 0px : 1.5px;
                                    border-color: #3a414d;
                                    animate background { duration: 120ms; }
                                    if r.added: Icon { width: 14px; height: 14px; stroke-width: 2.4px; commands: Icons.check; tint: white; }
                                }
                            }
                        }
                    }
                }
                Hint { text: "Нажми ещё раз, чтобы убрать набор из списка. Наборы скачиваются сами и обновляются раз в неделю."; }
            }
        }
    }

    // ================= Выбор программы =================
    if root.picking: Rectangle {
        background: #000000a0;
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 160ms; }
        TouchArea { clicked => { root.close-picker(); } }
        Rectangle {
            x: 16px;
            y: 50px;
            width: parent.width - 32px;
            height: parent.height - 100px;
            border-radius: 14px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            TouchArea { }
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    Text { text: "Запущенные программы"; font-size: 15px; font-weight: 600; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; }
                    GhostIcon { icon: Icons.close; clicked => { root.close-picker(); } }
                }
                Field {
                    placeholder-text: "Поиск…";
                    edited(t) => { root.process-filter(t); }
                }
                ListView {
                    vertical-stretch: 1;
                    for p in root.processes: Rectangle {
                        height: 36px;
                        border-radius: 8px;
                        background: pta.has-hover ? Theme.card2 : transparent;
                        animate background { duration: 120ms; }
                        pta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.process-chosen(p); }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Icon { width: 15px; height: 15px; commands: Icons.app; tint: Theme.muted; }
                            }
                            Text { text: p; color: Theme.text; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
    }
}
