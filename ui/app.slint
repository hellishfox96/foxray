import { ListView, ScrollView } from "std-widgets.slint";

// =====================================================================
// Данные из Rust
// =====================================================================

export struct Row {
    kind: int,          // 0 — заголовок группы, 1 — сервер
    title: string,
    sub: string,
    badge: string,
    ping: string,
    ping-state: int,    // 0 нет, 1 быстро, 2 медленно, 3 недоступен, 4 проверка
    selected: bool,
    index: int,         // номер сервера
    key: string,        // ключ группы
    collapsed: bool,
    count: int,
    refreshable: bool,  // группа — подписка
    code: string,       // код страны из флага в имени: «DE»
    busy: bool,         // подписка обновляется
    bad: bool,          // подписка не обновилась (sub — текст ошибки)
    first: bool,        // строка — верх карточки группы
    last: bool,         // строка — низ карточки группы
    fav: bool,          // сервер в избранном / группа «Избранное»
}

export struct RuleCard {
    name: string,
    builtin: bool,
    action: int,        // 0 VPN, 1 напрямую, 2 блок, 3 zapret
    enabled: bool,
    summary: string,
    index: int,         // номер списка в rules.json
    last: bool,         // последняя строка карточки
}

export struct EntryItem {
    text: string,
    kind: string,
    icon: int,          // 0 программа, 1 домен, 2 сеть, 3 ошибка, 4 набор,
                        // 5 заголовок «Из сборки zapret» (нажатие — свернуть/развернуть), 6 домен сборки (без крестика)
    first: bool,        // верх карточки
    last: bool,         // низ карточки
}

export struct FieldItem {
    key: string,
    label: string,
    value: string,
    hint: string,
    kind: int,          // 0 текст, 1 переключатель, 2 выбор
    labels: [string],
    choice: int,
}

export struct SetRow {
    kind: int,          // 0 — заголовок группы, 1 — набор
    title: string,
    sub: string,
    added: bool,
    index: int,         // номер в каталоге
}

export struct SubItem {
    name: string,
    info: string,
}

// =====================================================================
// Стиль
// =====================================================================

// Стратегия zapret в списке. state: 0 — не проверена, 1 — хорошо, 2 — частично, 3 — не работает, 4 — проверяется
// Строка «Куда идёт трафик». kind: 0 VPN, 1 zapret, 2 напрямую, 3 блок, 4 не действует
// target: 0 — сменить режим, 1 — страница zapret, 2 — вкладка «Правила»
export struct RouteRow {
    title: string,
    sub: string,
    chip: string,
    kind: int,
    target: int,
}

// Строка страницы «Соединения». kind: 0 VPN, 1 zapret, 2 напрямую, 4 прочее
export struct ConnRow {
    id: string,
    host: string,
    sub: string,
    route: string,
    traffic: string,
    kind: int,
    // Заголовок группы (программы) — host содержит «CLAUDE.EXE · 4».
    header: bool,
    // Первая / последняя строка в группе — для скруглений карточки.
    first: bool,
    last: bool,
}

export struct ZapretRow {
    title: string,
    result: string,
    selected: bool,     // у шапки «Ещё N» — раскрыто
    state: int,
    index: int,         // номер стратегии (для выбора)
    header: bool,       // строка «Ещё N — не проверены» (нажатие — раскрыть)
    first: bool,
    last: bool,
}

export struct ReleaseRow {
    version: string,
    date: string,
    notes: [string],
    is-new: bool,       // новее установленной
    installed: bool,    // установленная
}

export global Theme {
    out property <color> bg: #101216;
    out property <color> panel: #16191f;
    out property <color> card: #1c2028;
    out property <color> card2: #232833;
    out property <color> line: #2a303b;
    out property <color> text: #eceef2;
    out property <color> muted: #8b93a1;
    out property <color> dim: #5d6573;
    out property <color> accent: #ff7a2f;
    out property <color> ok: #2fbf71;
    out property <color> warn: #e7b43c;
    out property <color> bad: #ec6a5e;
    out property <color> vpn: #5b8cff;
    out property <color> zap: #a970ff;
}

